NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mobilemate

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (product/device images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default admin (used by seed script)
DEFAULT_ADMIN_EMAIL=admin@mobilemate.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# AI Service Microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=mobilemate_ai_secret_key_2026
